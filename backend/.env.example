NODE_ENV=development
PORT=5001
FRONTEND_URL=https://medio.mywire.org
ALLOWED_ORIGINS=http://localhost:5173,https://medio.mywire.org,https://www.medio.mywire.org
CAPACITOR_ORIGINS=capacitor://localhost,http://localhost,https://localhost
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=medio-api
JWT_AUDIENCE=medio-web
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback
# Render injects OTP_HOSTPORT from the private OTP service as host:port.
# The backend connects to OTP_HOSTPORT over HTTP unless OTP_BASE_URL is set.
OTP_HOSTPORT=localhost:8080
# Optional override. If set, this full URL takes precedence over OTP_HOSTPORT.
OTP_BASE_URL=http://localhost:8080
OTP_GRAPHQL_URL=http://localhost:8080/otp/routers/default/index/graphql
OTP_ISOCHRONE_URL=http://localhost:8080/otp/routers/default/isochrone
BCRYPT_ROUNDS=12
LOG_LEVEL=info
